{
  "id": "pluto-tv",
  "name": "Mendezino TV",
  "version": "1.2.2",
  "apiVersion": 3,
  "entry": "plugin.js",
  "description": "Canales en vivo de Pluto TV, Samsung TV Plus y Roku TV con auto-renovación ante 401/403",
  "author": "elmendezz",
  "homepage": "https://github.com/elmendezz/kino-plugin-pluto",
  "hosts": [
    "pluto.tv",
    "*.pluto.tv",
    "raw.githubusercontent.com",
    "i.mjh.nz",
    "*.cloudfront.net",
    "*.wurl.tv",
    "*.amagi.tv",
    "*.samsungcloud.tv",
    "*.akamaihd.net"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "resolve",
    "channels"
  ],
  "liveStreamHosts": "any",
  "color": "#1955FD",
  "icon": "icon.png",
  "settings": [
    {
      "key": "region",
      "label": "Región de canales",
      "type": "select",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todas las regiones"
        },
        {
          "value": "es",
          "label": "España"
        },
        {
          "value": "mx",
          "label": "México / Latinoamérica"
        },
        {
          "value": "us",
          "label": "Estados Unidos"
        }
      ]
    },
    {
      "key": "platform",
      "label": "Plataforma principal",
      "type": "select",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todas (Pluto, Samsung, Roku)"
        },
        {
          "value": "pluto",
          "label": "Solo Pluto TV"
        },
        {
          "value": "samsung",
          "label": "Solo Samsung TV Plus"
        },
        {
          "value": "roku",
          "label": "Solo Roku TV"
        }
      ]
    }
  ]
}