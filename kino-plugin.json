{
  "id": "pluto-tv",
  "name": "Mendezino TV",
  "version": "2.3.4",
  "apiVersion": 3,
  "entry": "plugin.js",
  "description": "Canales en vivo de Pluto TV, Samsung TV Plus y Roku TV",
  "author": "elmendezz",
  "homepage": "https://github.com/elmendezz/kino-plugin-pluto",
  "hosts": [
    "pluto.tv",
    "*.pluto.tv",
    "raw.githubusercontent.com",
    "github.com",
    "i.mjh.nz",
    "*.cloudfront.net",
    "*.wurl.tv",
    "*.amagi.tv",
    "*.samsungcloud.tv",
    "*.akamaihd.net"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "resolve",
    "channels"
  ],
  "liveStreamHosts": "any",
  "color": "#424242",
  "icon": "icon.png",
  "settings": [
    {
      "key": "region",
      "label": "Region de canales",
      "type": "select",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todas"
        },
        {
          "value": "us",
          "label": "Estados Unidos"
        },
        {
          "value": "es",
          "label": "Espana"
        },
        {
          "value": "mx",
          "label": "Mexico / Latinoamerica"
        },
        {
          "value": "ca",
          "label": "Canada"
        },
        {
          "value": "gb",
          "label": "Reino Unido"
        },
        {
          "value": "de",
          "label": "Alemania"
        },
        {
          "value": "fr",
          "label": "Francia"
        },
        {
          "value": "it",
          "label": "Italia"
        },
        {
          "value": "br",
          "label": "Brasil"
        },
        {
          "value": "ar",
          "label": "Argentina"
        },
        {
          "value": "cl",
          "label": "Chile"
        }
      ]
    },
    {
      "key": "quality",
      "label": "Calidad de Pluto TV",
      "type": "select",
      "default": "720p",
      "options": [
        {
          "value": "720p",
          "label": "720p"
        },
        {
          "value": "1080p",
          "label": "1080p (experimental)"
        },
        {
          "value": "2k",
          "label": "2K (experimental)"
        },
        {
          "value": "4k",
          "label": "4K (experimental)"
        }
      ]
    },
    {
      "key": "platform",
      "label": "Plataforma principal",
      "type": "select",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todas (Pluto, Samsung, Roku)"
        },
        {
          "value": "pluto",
          "label": "Solo Pluto TV"
        },
        {
          "value": "samsung",
          "label": "Solo Samsung TV Plus"
        },
        {
          "value": "roku",
          "label": "Solo Roku TV"
        }
      ]
    }
  ]
}